# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.
# Without them the site still runs, and says plainly that checkout and launch emails aren't set up.

# Local development. In production, use https://snaggo.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test keys until you're ready): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Not secret: the checkout page gives it to Stripe.js (pk_test_... / pk_live_...)
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint for https://<your-site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: 1 to turn on Stripe Tax; the countries to ship to (CA,US by default, or just CA)
STRIPE_AUTOMATIC_TAX=
STRIPE_SHIPPING_COUNTRIES=CA,US

# Shipping prices. With all three Canada Post values set, checkout asks Canada Post for the
# price to each address; without them it uses the region table in src/lib/shipping.ts.
# Key and secret: Canada Post Developer Portal > Apps > your app's credentials, with the
# Rating API added to the app. A "Test" app gives made-up prices, a "Production" app real ones.
# Customer number: your Solutions for Small Business number (10 digits, keep the leading zeros).
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=
CANADA_POST_CUSTOMER_NUMBER=
# The packed parcel (weigh a real one): box + padding in kg, each Lumi in kg, box size in cm,
# an optional packing charge in cents added to every shipping price, and where parcels ship from.
SHIPPING_BOX_KG=0.08
SHIPPING_UNIT_KG=0.03
SHIPPING_BOX_CM=10x10x6
SHIPPING_HANDLING_CENTS=0
SHIPPING_FROM_POSTAL_CODE=K1R6A1

# Supabase: Project Settings -> API. The service role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: https://resend.com/api-keys, and a sender on a verified domain,
# e.g. Snaggo <hello@snaggo.tech>
RESEND_API_KEY=
EMAIL_FROM=
# Any long random string; used to hash visitor IPs for signup rate limiting
SIGNUP_HASH_SALT=
# Turns on the order admin at /admin. Use a long random password; changing it signs everyone out.
ADMIN_PASSWORD=

# Open the Pocket Lumi for pre-order at a clearly marked demo price, to try the cart.
# On Vercel's production deployment it also needs LUMI_DEMO_ON_PRODUCTION=1.
# Always refused when STRIPE_SECRET_KEY is a live key. Remove both before you sell for real.
LUMI_DEMO_CATALOGUE=
LUMI_DEMO_ON_PRODUCTION=
