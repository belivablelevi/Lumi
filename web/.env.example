# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.
# Without them the site still runs, and says plainly that checkout and launch emails aren't set up.

# Local development. In production, use https://snaggo.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test keys until you're ready): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Not secret: the checkout page gives it to Stripe.js (pk_test_... / pk_live_...)
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint for https://<your-site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: 1 to turn on Stripe Tax; the countries to ship to (CA,US by default, or just CA)
STRIPE_AUTOMATIC_TAX=
STRIPE_SHIPPING_COUNTRIES=CA,US

# Shipping prices: a flat price per region before tax, in dollars. Any left out use the
# defaults in src/lib/shipping.ts (8, 9, 15, 10, from Chit Chats quotes).
SHIPPING_PRICE_ON_QC=8
SHIPPING_PRICE_REST_OF_CANADA=9
SHIPPING_PRICE_NORTH=15
SHIPPING_PRICE_US=10
# US orders also pay import duties up front: this percent of the order's value, plus a fee in
# dollars per order (Chit Chats' broker and items fees).
SHIPPING_US_DUTY_PERCENT=10
SHIPPING_US_DUTY_FEE=2.10
# Optional: Canadian orders at or over this many dollars ship free. Leave empty for never.
SHIPPING_FREE_OVER=
# ...but only where its shipping costs less than this many dollars (default 15, which leaves out
# the North at $15). "none" makes it free everywhere in Canada.
SHIPPING_FREE_MAX=15
# Optional live prices: with all three Canada Post values set, checkout asks Canada Post for
# the price to each address instead, and uses the flat prices above if it doesn't answer.
# Key and secret: Canada Post Developer Portal > Apps > your app's credentials, with the
# Rating API added to the app. A "Test" app gives made-up prices, a "Production" app real ones.
# Customer number: your Solutions for Small Business number (10 digits, keep the leading zeros).
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=
CANADA_POST_CUSTOMER_NUMBER=
# The packed parcel (weigh a real one): box + padding in kg, each Lumi in kg, box size in cm,
# an optional packing charge in cents added to every shipping price, and where parcels ship from.
SHIPPING_BOX_KG=0.08
SHIPPING_UNIT_KG=0.03
SHIPPING_BOX_CM=10x10x6
SHIPPING_HANDLING_CENTS=0
SHIPPING_FROM_POSTAL_CODE=K1R6A1
# parcel, or thick_envelope for a padded mailer (what Chit Chats is told), for one Lumi.
SHIPPING_PACKAGE_TYPE=parcel
# Orders of more than one Lumi must go in a sturdy cardboard box (Chit Chats' battery rules):
# its size in cm and its weight with padding in kg. Unset uses SHIPPING_BOX_CM and SHIPPING_BOX_KG.
SHIPPING_MULTI_BOX_CM=
SHIPPING_MULTI_BOX_KG=

# Chit Chats labels in the order admin: Chit Chats -> Settings -> Developer -> API Access Tokens.
# Mark the token Sensitive in Vercel. CHIT_CHATS_SANDBOX=1 uses staging.chitchats.com (fake credits).
CHIT_CHATS_CLIENT_ID=
CHIT_CHATS_ACCESS_TOKEN=
CHIT_CHATS_SANDBOX=
# The customs form for US labels. The origin country (two letters) has no default: a customs
# broker confirms it. The battery code is for one Lumi per package, confirmed by Chit Chats
# ("none" for no code). More than one Lumi is sent as CLASS_9_MARKED_LITHIUM_BATTERY, and
# Canadian shipments carry no code (Chit Chats said they don't need declaring).
CUSTOMS_HS_CODE=9503.00
CUSTOMS_ORIGIN_COUNTRY=
CHIT_CHATS_HAZMAT_CODE=CLASS_9_UNMARKED_LITHIUM_BATTERY

# Supabase: Project Settings -> API. The service role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: https://resend.com/api-keys, and a sender on a verified domain,
# e.g. Snaggo <hello@snaggo.tech>
RESEND_API_KEY=
EMAIL_FROM=
# Any long random string; used to hash visitor IPs for signup rate limiting
SIGNUP_HASH_SALT=
# Turns on the order admin at /admin. Use a long random password; changing it signs everyone out.
ADMIN_PASSWORD=

# Open the Pocket Lumi for pre-order at a clearly marked demo price, to try the cart.
# On Vercel's production deployment it also needs LUMI_DEMO_ON_PRODUCTION=1.
# Always refused when STRIPE_SECRET_KEY is a live key. Remove both before you sell for real.
LUMI_DEMO_CATALOGUE=
LUMI_DEMO_ON_PRODUCTION=
